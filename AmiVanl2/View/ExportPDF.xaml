<UserControl x:Class="AmiVanl2.View.ExportPDF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="860"
             Background="White">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Export PDF"
                       FontSize="30"
                       FontFamily="Bahnschrift"
                       FontWeight="Bold"
                       Foreground="#1E1E1E"/>
            <TextBlock Text="Génération du rapport de suivi de production au format A3 paysage."
                       FontSize="13"
                       FontFamily="Bahnschrift"
                       Foreground="#666666"/>
        </StackPanel>

        <!-- LISTE DES SECTIONS -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                CornerRadius="12"
                Padding="22"
                Margin="0,8,0,8">
            <StackPanel>
                <TextBlock Text="Sections incluses dans le rapport"
                           FontSize="16"
                           FontFamily="Bahnschrift"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <ItemsControl x:Name="ListeSections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8"
                                    Margin="0,3"
                                    Padding="14,8">
                                <Border.Background>
                                    <Binding Path="Fond"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Titre}"
                                               FontFamily="Bahnschrift"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NbElements}"
                                               FontFamily="Bahnschrift"
                                               FontSize="11"
                                               Foreground="#555555"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Statut}"
                                               FontFamily="Bahnschrift"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding CouleurStatut}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- MESSAGE DE STATUT -->
        <TextBlock x:Name="TxtStatut"
                   Grid.Row="2"
                   FontFamily="Bahnschrift"
                   FontSize="13"
                   Foreground="#555555"
                   Margin="0,2,0,6"
                   TextWrapping="Wrap"/>

        <!-- BOUTONS GÉNÉRER -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Le PDF sera généré en A3 paysage, prêt pour impression."
                       FontFamily="Bahnschrift"
                       FontSize="11"
                       Foreground="#888888"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Name="BtnPdfImprimer"
                    Content="Version impression"
                    Width="180"
                    Height="44"
                    Margin="0,0,10,0"
                    FontFamily="Bahnschrift"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#555555"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="PDF sans pages de séparation — idéal pour imprimer et distribuer"
                    Click="BtnPdfImprimer_Click"/>

            <Button Grid.Column="2"
                    Name="BtnPdfGenerate"
                    Content="Rapport complet"
                    Width="180"
                    Height="44"
                    FontFamily="Bahnschrift"
                    FontSize="13"
                    FontWeight="Bold"
                    Background="#2F5D8C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="PDF avec pages de séparation par section — idéal pour présenter en réunion"
                    Click="BtnPdfGenerate_Click"/>
        </Grid>
    </Grid>
</UserControl>
