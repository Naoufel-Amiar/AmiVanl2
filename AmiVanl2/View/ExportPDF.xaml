<UserControl x:Class="AmiVanl2.View.ExportPDF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmiVanl2.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Export PDF"
                       FontSize="30"
                       FontFamily="Bahnschrift"
                       FontWeight="Bold"/>

            <TextBlock Text="Prévisualisation des pages qui seront assemblées dans le rapport PDF."
                       FontSize="14"
                       FontFamily="Bahnschrift"
                       Foreground="#666666"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F5F5F5"
                CornerRadius="15"
                Padding="25">

            <StackPanel>
                <TextBlock Text="Pages incluses dans le PDF"
                           FontSize="22"
                           FontFamily="Bahnschrift"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <ListBox x:Name="ListePagesPdf"
                         FontSize="16"
                         FontFamily="Bahnschrift"
                         Height="250"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Générer le PDF"
                Name="BtnPdfGenerate"
                Width="220"
                Height="45"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                FontFamily="Bahnschrift"
                FontSize="16"
                FontWeight="Bold" Click="BtnPdfGenerate_Click"/>
    </Grid>
</UserControl>
