<UserControl x:Class="AmiVanl2.View.SuiviAssAuto2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="White"
             MinWidth="900"
             MinHeight="550">

    <Grid Margin="25" Background="#F7F7F7">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Suivi assemblage automatique — objectifs semaine"
                           FontSize="28"
                           FontFamily="Bahnschrift"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"/>

                <TextBlock Text="Répartition de l’objectif semaine par référence."
                           FontSize="14"
                           FontFamily="Bahnschrift"
                           Foreground="#555555"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Retour page 1"
                    Width="160"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Bahnschrift"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#2F5D8C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnRetourPage1_Click"/>
        </Grid>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Camemberts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            CornerRadius="10"
                            Margin="8"
                            Padding="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Titre}"
                                       FontFamily="Bahnschrift"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <oxy:PlotView Grid.Row="1"
                                          Model="{Binding PlotModel}"
                                          MinHeight="180"/>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding Resume}"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>

</UserControl>
