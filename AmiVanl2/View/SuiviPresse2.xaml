<UserControl x:Class="AmiVanl2.View.SuiviPresse2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
    <Grid Background="#F7F7F7" Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Suivi presses — objectifs semaine"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Répartition de l’objectif semaine par référence."
                           FontSize="13"
                           Foreground="#444"/>
            </StackPanel>

            <Button Content="← Retour"
                    Width="160"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Bahnschrift"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#2F5D8C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" 
                    Click="BtnRetourPage1_Click"/>
        </DockPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Camemberts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            CornerRadius="12"
                            Margin="8"
                            Padding="10"
                            BorderBrush="#DDD"
                            BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Titre}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <oxy:PlotView Grid.Row="1"
                                          Model="{Binding PlotModel}"
                                          MinHeight="180"/>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding Resume}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>