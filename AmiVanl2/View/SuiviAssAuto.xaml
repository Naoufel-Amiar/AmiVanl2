<UserControl x:Class="AmiVanl2.View.SuiviAssAuto"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             MinWidth="900"
             MinHeight="550">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Suivi assemblage automatique"
                       FontSize="30"
                       FontFamily="Bahnschrift"
                       FontWeight="Bold"
                       Foreground="#1E1E1E"/>

            <Button Grid.Column="1"
                Content="Voir les Objectifs"
                Width="160"
                Height="38"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="Bahnschrift"
                FontSize="13"
                FontWeight="SemiBold"
                Background="#2F5D8C"
                Foreground="White"
                BorderThickness="0"
                Name="BtnGoToPage2AssAuto"
                Cursor="Hand" Click="BtnGoToPage2AssAuto_Click"/>


            <TextBlock Text="Analyse des productions journalières par référence et machine."
                       FontSize="14"
                       FontFamily="Bahnschrift"
                       Foreground="#666666"/>
            
        </StackPanel>

        <!-- COMMENTAIRES -->
        <Border
            x:Name="PanelCommentaires"
            Grid.Row="1"
            Background="#FFF8E1"
            BorderBrush="#F59E0B"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,8"
            Padding="12,8"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    Text="💬 Commentaires de la semaine"
                    FontSize="13"
                    FontFamily="Bahnschrift"
                    FontWeight="SemiBold"
                    Foreground="#92400E"
                    Margin="0,0,0,4"/>
                <ItemsControl x:Name="ListeCommentaires">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                FontSize="12"
                                FontFamily="Bahnschrift"
                                Foreground="#78350F"
                                TextWrapping="Wrap"
                                Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#F6E1CF"
                CornerRadius="15"
                Padding="30"
                Margin="0,10,0,0">

            <Grid>
                <TextBlock Text="1 — Production journalière VS objectif"
                           FontSize="20"
                           FontFamily="Bahnschrift"
                           FontWeight="SemiBold"
                           Foreground="#222222"
                           VerticalAlignment="Top"/>

                <Grid Margin="0,45,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.65*"/>
                        <RowDefinition Height="0.95*"/>
                        <RowDefinition Height="1.65*"/>
                        <RowDefinition Height="1.15*"/>
                    </Grid.RowDefinitions>

                    <oxy:PlotView x:Name="PlotAssAutoGroupe1" Grid.Row="0"/>

                    <Grid x:Name="LegendAssAutoGroupe1" Grid.Row="1"/>

                    <oxy:PlotView x:Name="PlotAssAutoGroupe2" Grid.Row="2"/>

                    <Grid x:Name="LegendAssAutoGroupe2" Grid.Row="3"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
