<UserControl
    x:Class="AmiVanl2.View.AccImport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="900"
    MinHeight="550"
    Background="White">

    <UserControl.Resources>

        <Style x:Key="GenerateButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <Grid Background="White" Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Titre -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Accueil / Import"
                       FontSize="30"
                       FontFamily="Bahnschrift"
                       FontWeight="Bold"
                       Foreground="#1E1E1E"/>

            <TextBlock Text="Importez vos données pour la génération de graphiques."
                       FontSize="14"
                       FontFamily="Bahnschrift"
                       Foreground="#666666"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Drag & Drop -->
        <Border Grid.Row="1"
                x:Name="DropZone"
                Background="#F5F5F5"
                BorderBrush="#AAAAAA"
                BorderThickness="2"
                CornerRadius="15"
                Padding="20"
                AllowDrop="True"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="&#x1F4C2;"
                           FontSize="46"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtDropMessage"
                           Text="Glisse ton fichier Excel ici"
                           FontSize="20"
                           FontFamily="Bahnschrift"
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtSelectedFile"
                           Text="Aucun fichier sélectionné"
                           FontSize="13"
                           FontFamily="Bahnschrift"
                           Foreground="#777777"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>

                <Button Content="Parcourir"
                        Width="150"
                        Height="36"
                        Margin="0,15,0,0"
                        Click="BtnBrowseFile_Click"/>

            </StackPanel>

        </Border>


        <!-- Bouton génération -->
        <StackPanel Grid.Row="2" Margin="0,25,0,0" HorizontalAlignment="Center">

            <StackPanel x:Name="PanelChargement"
                        Visibility="Collapsed"
                        Margin="0,0,0,14">
                <TextBlock Text="Lecture du fichier Excel en cours…"
                           FontFamily="Bahnschrift"
                           FontSize="13"
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True"
                             Width="260"
                             Height="6"
                             Foreground="#1E88E5"
                             Background="#DDDDDD"/>
            </StackPanel>

            <Button Content="DÉMARRER LA GÉNÉRATION" Name="BtnGenerate"
                    Style="{StaticResource GenerateButtonStyle}" Click="BtnGenerate_Click"/>

        </StackPanel>

    </Grid>

</UserControl>
