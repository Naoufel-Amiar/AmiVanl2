<UserControl x:Class="AmiVanl2.View.SuiviAssManuel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <Grid Background="White" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="SUIVI ASS MANUEL"
            FontSize="30"
            FontFamily="Bahnschrift"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"/>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="ListeReferences">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="540"
                            Height="430"
                            Margin="12"
                            Padding="15"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#FAFAFA">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="{Binding Titre}"
                                    FontSize="18"
                                    FontFamily="Bahnschrift"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10"/>

                                <oxy:PlotView
                                    Grid.Row="1"
                                    Model="{Binding Graphique}"/>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">

                                    <TextBlock
                                        Text="{Binding InfoCapuchon}"
                                        FontFamily="Bahnschrift"
                                        FontSize="13"/>

                                    <TextBlock
                                        Text="{Binding InfoInsert}"
                                        FontFamily="Bahnschrift"
                                        FontSize="13"/>

                                    <TextBlock
                                        Text="{Binding InfoObjectif}"
                                        FontFamily="Bahnschrift"
                                        FontSize="13"
                                        FontWeight="SemiBold"/>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>