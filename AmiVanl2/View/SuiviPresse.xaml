<UserControl x:Class="AmiVanl2.View.SuiviPresse"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             MinWidth="900"
             MinHeight="550">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- TITRES -->
            <StackPanel Grid.Column="0">

                <TextBlock Text="Suivi production presse"
                           FontSize="30"
                           FontFamily="Bahnschrift"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"/>

                <TextBlock Text="Analyse des productions journalières par référence et machine."
                           FontSize="14"
                           FontFamily="Bahnschrift"
                           Foreground="#666666"/>
            </StackPanel>

            <!-- BOUTON -->
            <Button Grid.Column="1"
                    Content="Voir les Objectifs "
                    Width="160"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Bahnschrift"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="#2F5D8C"
                    Foreground="White"
                    BorderThickness="0"
                    Name="BtnGoToPage2Presse"
                    Cursor="Hand" Click="BtnGoToPage2Presse_Click"/>
        </Grid>

        <!-- COMMENTAIRES -->
        <Border
            x:Name="PanelCommentaires"
            Grid.Row="1"
            Background="#FFF8E1"
            BorderBrush="#F59E0B"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,8"
            Padding="12,8"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    Text="💬 Commentaires de la semaine"
                    FontSize="13"
                    FontFamily="Bahnschrift"
                    FontWeight="SemiBold"
                    Foreground="#92400E"
                    Margin="0,0,0,4"/>
                <ItemsControl x:Name="ListeCommentaires">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                FontSize="12"
                                FontFamily="Bahnschrift"
                                Foreground="#78350F"
                                TextWrapping="Wrap"
                                Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- CONTENU -->
        <Border Grid.Row="2"
                Background="#CEC3C1"
                CornerRadius="15"
                Padding="30"
                MinHeight="900"
                Margin="0,10,0,0">

            <Grid>

                <TextBlock Text="1 — Production journalière VS objectif"
                           FontSize="20"
                           FontFamily="Bahnschrift"
                           FontWeight="SemiBold"
                           Foreground="#222222"
                           VerticalAlignment="Top"/>

                <Grid Margin="0,45,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="165"/>
                        <RowDefinition Height="95"/>
                        <RowDefinition Height="165"/>
                        <RowDefinition Height="115"/>
                    </Grid.RowDefinitions>

                    <!-- GROUPE 1 -->
                    <oxy:PlotView x:Name="PlotPresseGroupe1"
                                  Grid.Row="0"
                                  Margin="0,0,0,0"/>

                    <Grid x:Name="LegendPresseGroupe1"
                          Grid.Row="1"
                          Margin="0,0,0,0"/>

                    <!-- GROUPE 2 -->
                    <oxy:PlotView x:Name="PlotPresseGroupe2"
                                  Grid.Row="2"
                                  Margin="0,0,0,0"/>

                    <Grid x:Name="LegendPresseGroupe2"
                          Grid.Row="3"
                          Margin="0,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>