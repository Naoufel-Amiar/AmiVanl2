<Window x:Class="AmiVanl2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmiVanl2"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1400">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#303030"/>

            <Style.Triggers>

                <Trigger Property="IsEnabled"
                     Value="False">

                    <Setter Property="Background"
                        Value="#1A1A1A"/>

                    <Setter Property="Foreground"
                        Value="#666666"/>

                    <Setter Property="Opacity"
                        Value="0.7"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="25,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#EEEEEE">

        <!-- Découpage principal -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="166"/>
            <ColumnDefinition Width="54"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Zone logo + crédits -->
        <Border Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Background="#1E1E1E"
            Padding="15">

            <Grid>
                <TextBlock Text="EV TRACKING"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

                <TextBlock Text="Projet réalisé par Naoufel Amiar"
                       Foreground="White"
                       FontSize="14"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
            </Grid>

        </Border>


        <!-- Panneau de déplacement entre fenêtres -->
        <Border Grid.Row="1"
            Grid.Column="0"
            Background="#2D2D30"
            Padding="15" Grid.ColumnSpan="2">

            <StackPanel>

                <TextBlock Text="Navigation"
                       Foreground="White"
                        FontSize="22"
                        FontFamily="Bahnschrift"
                        FontWeight="Bold"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"/>

                <Button Content="Accueil/Import" Name="BtnAccueilImport"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnAccueilImport_Click"/>


                <Button Content="Suivi PRESSE" Name="BtnSuiviPresse"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnSuiviPresse_Click"/>

                <Button Content="Suivi TRI" Name="BtnSuiviTri"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnSuiviTri_Click"/>

                <Button Content="Suivi ASS AUTO" Name="BtnSuiviAssAuto"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnSuiviAssAuto_Click"/>

                <Button Content="Suivi ASS MANUEL" Name="BtnSuiviAssManuel"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnSuiviAssManuel_Click"/>

                <Button Content="Suivi JOINTS" Name="BtnSuiviJoints"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnSuiviJoints_Click"/>

                <Button Content="Export PDF" Name="BtnExportPDF"
                    Style="{StaticResource MenuButtonStyle}" Click="BtnExportPDF_Click"/>

            </StackPanel>

        </Border>



        <!-- Zone d'affichage des fenêtres/pages -->
        <Border Grid.Row="1"
            Grid.Column="2"
            Background="White"
            Padding="25">

            <Grid x:Name="MainContent">


            </Grid>
        </Border>
    </Grid>
</Window>